# z/OS toolchain fix (apply to the IBM Open Enterprise LLVM C++ headers):
#   include/c++/v1/__thread/poll_with_backoff.h
#
# z/OS <poll.h> uses `__poll` as its include guard (#define __poll 1), which
# leaks into libc++ and collides with the `__poll` parameter name below.
# Any TU that includes <poll.h> before libc++ headers fails with
# "error: expected ')'" / "called object type 'int' is not a function".
# Rename the private parameter to avoid the collision.
#
# Applied locally to:
# /home/haritha/install_test/usr/lpp/IBM/oelcpp/v3r0/include/c++/v1/__thread/poll_with_backoff.h
